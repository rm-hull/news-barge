---
layout: base.njk
title: Search
permalink: /search/
---
<link href="/pagefind/pagefind-component-ui.css" rel="stylesheet">
<section class="index-section">
  <h1 class="page-title">Search</h1>
  <pagefind-input autofocus=true></pagefind-input>
  <pagefind-summary></pagefind-summary>
  <pagefind-results>
    <script type="text/pagefind-template">
      {% raw %}
      <li class="article-card">
        <div class="article-card-thumbnail">
          {{#if meta.thumbnail}}
            <a href="{{ url | safeUrl }}">
              <img src="{{ meta.thumbnail }}" loading="lazy">
            </a>
          {{/if}}
        </div>
        <div class="article-card-content">
          <div class="article-card-meta">
            {{#if meta.source_site }}
              <a href="/sites/{{ meta.source_slug }}/" class="site-tag">{{ meta.source_site }}</a>
            {{/if}}
            <time datetime="{{ meta.date }}">{{ meta.date }}</time>
          </div>
          <h2 class="article-card-title">
            <a href="{{ url | safeUrl }}">{{ meta.title }}</a>
          </h2>
          {{#if excerpt}}
            <p class="article-card-deck">{{+ excerpt +}}</p>
          {{/if}}
        </div>
      </li>
      {% endraw %}
    </script>
  </pagefind-results>
</section>
<script src="/pagefind/pagefind-component-ui.js" type="module"></script>
<script type="module">
  const params = new URLSearchParams(window.location.search);
  const q = params.get('q');

  if (q) {
    const manager = window.PagefindComponents.getInstanceManager();
    const instance = manager.getInstance('default');

    // Make sure the search bundle is loaded, then run the query
    // (normally this only happens on focus, so we trigger it manually)
    instance.triggerLoad().then(() => {
      instance.triggerSearch(q);
    });
  }

  const syncUrlWithSearch = (term) => {
    const url = new URL(window.location.href);
    if (term) {
      url.searchParams.set('q', term);
    } else {
      url.searchParams.delete('q');
    }
    window.history.replaceState({}, '', url);
  };

  window.addEventListener('DOMContentLoaded', () => {
    const manager = window.PagefindComponents.getInstanceManager();
    const instance = manager.getInstance('default');
    instance.on('search', (term) => syncUrlWithSearch(term));
  });
</script>
