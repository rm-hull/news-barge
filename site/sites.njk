---
layout: base.njk
title: Sites
permalink: /sites/
---
<section class="index-section">
  <h1 class="page-title">Tracked sites</h1>
  <ul class="site-list">
    {% for site in sites | sort(attribute='sortName') %}
    {% set siteArticles = collections.articlesBySite[site.slug] %}
    {% if siteArticles and siteArticles.length > 0 %}
    <li class="site-card">
      <a href="/sites/{{ site.slug }}/">{{ site.name }}</a>
      <span class="site-meta">{{ siteArticles | length }} articles</span>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</section>
