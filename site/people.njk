---
layout: base.njk
title: People
permalink: /people/
---
<section class="index-section">
  <h1 class="page-title">People</h1>

  <ul class="people-list">
    {% for person in collections.peopleByArticleCount %}
    <li class="person-card">
      <a href="/people/{{ person.slug }}/">{{ person.name }}</a>
      <span class="person-meta">{{ person.count }} articles</span>
    </li>
    {% endfor %}
  </ul>
</section>
