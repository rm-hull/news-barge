{
  "name": "news-barge-site",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prestart": "[ -L content ] || ln -s ../content content",
    "link:content": "[ -L content ] || ln -s ../content content",
    "build:site": "npm run link:content && eleventy --config=eleventy.config.js --quiet",
    "build:search": "pagefind",
    "build": "npm run build:site && npm run build:search",
    "start": "eleventy --config=eleventy.config.js --serve --incremental",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.8",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10"
  }
}
